    "build:android-bridge": "node scripts/build.js android-bridge",
    "build:brotherhood": "node scripts/build.js brotherhood",
    "build:chrome-bridge": "node scripts/build.js chrome-bridge",
    "build:gmail": "node scripts/build.js gmail",
    "build:msteams": "node scripts/build.js msteams",
    "build:nut-js": "node scripts/build.js nut-js",
    "build:outlook": "node scripts/build.js outlook",
